#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define GALLIUM 1
#define NUM 2
#define NAV 3
#define BT 4
#define FN 5
#define MOUSE 6

/ {
        behaviors {
                hmt: homerow_mod_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <150>;
                        bindings = <&kp>, <&kp>;
                };
                mlt: mouse_layer_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <150>;
                        bindings = <&mo>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R        &kp T   &kp Y &kp U  &kp I    &kp O     &kp P          &mo FN
   &kp ESC   &kp A &kp S &kp D &hmt LSHFT F &kp G   &kp H &kp J  &kp K    &kp L     &hmt RSHFT SQT &kp SEMI
   &kp LSHFT &kp Z &kp X &kp C &kp V        &kp B   &kp N &kp M  &kp BSPC &kp COMMA &hmt RSHFT DOT        &mo BT
                         &kp LALT &mo NAV &kp SPACE   &kp RET &mo NUM &kp RCTRL
                        >;
                };

                gallium_layer {
                        bindings = <
   &kp TAB   &kp B &kp L &kp D &kp C        &kp V   &kp J &kp F &kp O    &kp U     &kp SEMI       &mo FN
   &kp ESC   &kp N &kp R &kp T &hmt LSHFT S &kp G   &kp Y &kp H &kp A    &kp E     &hmt RSHFT I   &kp SQT
   &kp LSHFT &kp X &kp Q &kp M &kp W        &kp Z   &kp K &kp P &kp BSPC &kp COMMA &kp DOT        &mo BT
                         &kp LALT &mo NAV &kp SPACE   &kp RET &mo NUM &kp RCTRL
                        >;
                };

                number_symbol_layer {
                        bindings = <
   &trans &kp N1 &kp N2    &kp N3   &kp N4    &kp N5      &kp N6   &kp N7   &kp N8   &kp N9       &trans &trans
   &trans &kp LT &kp GT    &kp LBKT &hmt LSHFT RBKT  &kp N0      &kp BSLH &kp FSLH &kp LPAR &kp RPAR     &hmt RSHFT SEMI &trans
   &trans &trans &kp GRAVE &kp PLUS &kp MINUS &kp EQUAL   &kp EXCL &kp AT   &kp BSPC &kp COLON &kp LSHFT &kp CAPSLOCK
                              &kp LCTRL &kp LSHFT &kp SPACE   &kp RET &trans &trans
                        >;
                };


                nav_layer {
                        bindings = <
   &trans &trans &kp LC(A)  &kp LC(C) &kp LC(V) &kp LC(X)           &trans &mkp LCLK &msc SCRL_DOWN &msc SCRL_UP &trans &to GALLIUM
   &trans &trans &trans     &kp HOME  &mlt MOUSE END   &kp LC(Z)           &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RS(RCTRL) &trans
   &trans &trans &trans     &trans    &trans    &kp LC(LS(Z))       &trans &trans &kp BSPC &trans &kp RS(RCTRL) &to BASE
                         &kp LALT &trans &trans                 &trans   &kp RCTRL &kp RGUI
                        >;
                };


                bluetooth_layer {
                        bindings = <
   &trans     &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans
                                      &trans &trans &trans   &trans &trans &trans
                        >;
                };

                fn_layer {
                        bindings = <
   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6      &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &trans
   &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12     &trans     &trans       &trans       &trans       &trans       &trans
   &trans    &trans    &trans    &trans    &trans    &trans      &trans     &trans       &trans       &trans       &trans       &trans
                                  &trans    &trans    &trans      &trans     &trans       &trans
                        >;
                };

                mouse_layer {
                        bindings = <
   &trans &trans &trans &trans &trans &trans      &trans &mkp LCLK &msc SCRL_DOWN &msc SCRL_UP &trans &trans
   &trans &trans &trans &trans &trans &trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
   &trans &trans &trans &trans &trans &trans      &trans &mkp RCLK &mkp MCLK &trans &trans &trans
                         &trans &trans &trans     &trans &trans &trans
                        >;
                };
        };
};
