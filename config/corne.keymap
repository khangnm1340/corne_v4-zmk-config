#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>

#define  BASE     0
#define  GALLIUM  1
#define  MAC      2
#define  MAC_NAV  3
#define  MAC_NUM  4
#define  BT       5
#define  NUM      6
#define  NAV      7
#define  FN       8
#define  MOUSE    9
#define  NUMPAD   10


/ {

        behaviors {
                hmt: homerow_mod_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <200>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                };
                hmt_layer: homerow_mod_tap_layer {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <6666>;
                        quick-tap-ms = <200>;
                        require-prior-idle-ms = <125>;
                        bindings = <&kp>, <&kp>;
                };
                mlt: mouse_layer_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <200>;
                        require-prior-idle-ms = <125>;
                        bindings = <&mo>, <&kp>;
                };


                backslash_forwardslash: backslash_forwardslash {
                    compatible = "zmk,behavior-mod-morph";
                    label = "BACKSLASH_FORWARDSLASH";
                    #binding-cells = <0>;
                    bindings = <&kp FSLH>, <&kp BSLH>;
                    mods = <(MOD_LSFT|MOD_RSFT)>;
                };
                /* dqt_sqt: dqt_sqt { */
                /*         compatible = "zmk,behavior-mod-morph"; */
                /*         label = "DQT_SQT"; */
                /*         #binding-cells = <0>; */
                /*         bindings = <&kp DQT>, <&kp SQT>; */
                /*         mods = <(MOD_LSFT|MOD_RSFT)>; */
                /* }; */
           };
        combos {
            compatible = "zmk,combos";

            esc_combo {
                timeout-ms = <80>;
                key-positions = <27 28>;
                layers = <GALLIUM>;
                bindings = <&kp ESC>;
            };
        };



        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R        &kp T   &kp Y &kp U  &kp I    &kp O     &kp P          &mo BT
   &kp ESC   &kp A &kp S &kp D &hmt LSHFT F &kp G   &kp H &kp J  &kp K    &kp L     &hmt RSHFT SQT &kp TAB
   &kp LSHFT &kp Z &kp X &kp C &kp V        &kp B   &kp N &kp M  &kp BSPC &kp COMMA &kp DOT        &mo FN
                         &kp LALT &mo NAV &kp SPACE   &kp RET &mo NUM &kp RCTRL
                        >;
                };

                gallium_layer {
                        bindings = <
   &kp TAB   &kp Z &kp L &kp D &kp C &kp V   &kp J &kp Y &kp O    &kp U     &kp PLUS  &kp MINUS
   &kp LSHIFT &kp N &kp R &kp T &kp S &kp G   &kp P &kp H &kp A    &kp E     &kp I    &kp RSHFT
   &mo BT &kp X &kp Q &kp M &kp W &kp B   &kp K &kp F &kp BSPC &kp COMMA &kp DOT  &mo FN
                         &kp LALT &mo NAV &kp SPACE   &kp RET &mo NUM &kp RCTRL
                        >;
                };

                mac_layer {
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R        &kp T   &kp Y &kp U  &kp I    &kp O     &kp P          &mo BT
   &kp ESC   &kp A &kp S &kp D &hmt LSHFT F &kp G   &kp H &kp J  &kp K    &kp L     &hmt RSHFT SQT &kp TAB
   &kp LSHFT &kp Z &kp X &kp C &kp V        &kp B   &kp N &kp M  &kp BSPC &kp COMMA &kp DOT        &mo FN
                         &kp LALT &mo MAC_NAV &kp SPACE   &kp RET &mo NUM &kp RGUI
                        >;
                };

                mac_nav_layer {
                        bindings = <
   &trans &trans &kp LG(A)  &kp LG(C) &kp LG(V) &kp LG(LS(Z))           &trans &mkp LCLK &kp PG_DN &kp PG_UP &trans &to GALLIUM
   &trans &kp LSHIFT &mo NUMPAD     &kp HOME  &mlt MOUSE END   &kp LG(Z)           &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RS(RALT) &to MAC
   &trans &kp LALT &trans     &trans    &kp LG(X)  &trans       &trans &kp DELETE &kp BSPC &trans &kp RS(RALT) &to BASE
                         &trans &trans &trans                 &kp RS(RET) &kp RALT &kp RCTRL
                        >;
                };

                mac_number_symbol_layer {
                        bindings = <
   &trans &kp EXCL &kp AT    &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS &kp COLON &kp STAR    &trans &trans
   &kp LC(SPACE) &kp GRAVE &kp EQUAL    &kp LBKT &kp RBKT &kp N0      &kp BSLH &kp FSLH &kp RPAR &kp LPAR   &kp SQT &kp CAPSLOCK
   &trans &trans &kp LT &kp GT &kp MINUS &kp EXCL          &trans &kp SEMI   &kp RA(BSPC) &kp RC(TAB) &kp RSHIFT &trans
                                  &trans &kp LSHIFT &kp SPACE   &trans &trans &trans
                        >;
                };

                bluetooth_layer {
                        bindings = <
   &trans     &trans       &trans       &bootloader     &ext_power EP_OFF     &trans       &trans &trans &bootloader &trans &trans &trans
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans
   &trans     &trans       &trans       &trans       &ext_power EP_ON   &trans       &trans &trans &trans &trans &trans &trans
                                      &trans &trans &trans   &trans &trans &trans
                        >;
                };

                number_symbol_layer {
                        bindings = <
   &trans &kp EXCL &kp AT    &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS &kp COLON &kp STAR    &trans &trans
   &kp LA(SPACE) &kp GRAVE &kp LBKT &kp RBKT &kp EQUAL     &kp N0      &kp PIPE &backslash_forwardslash &kp RPAR &kp LPAR     &kp SQT &kp CAPSLOCK
   &trans &trans &trans &kp UNDER &kp MINUS &kp PLUS          &trans &kp SEMI   &kp RC(BSPC) &kp RC(TAB) &kp RCTRL &trans
                                  &kp LGUI &kp LSHIFT &kp SPACE   &trans &trans &trans
                        >;
                };

                nav_layer {
                        bindings = <
   &trans &trans &kp LC(A)  &kp LC(C) &kp LC(V) &kp LC(LS(Z))           &trans &mkp LCLK &kp PG_DN &kp PG_UP &trans &trans
   &trans &kp LSHIFT &mo NUMPAD     &kp HOME  &mlt MOUSE END   &kp LC(Z)           &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp RS(RCTRL)  &trans
   &trans &kp LALT &trans     &trans    &kp LC(X)  &trans       &trans &kp DELETE &kp BSPC &kp DQT &kp QMARK &trans
                         &trans &trans &trans                 &kp RS(RET) &kp RCTRL &kp RGUI
                        >;
                };

                fn_layer {
                        bindings = <
    &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5      &trans     &trans       &trans       &trans       &trans       &trans
    &trans    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10     &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &trans
    &trans    &kp F11   &kp F12   &trans    &trans    &trans      &trans     &kp C_PLAY_PAUSE    &kp C_BKLT_TOG       &trans       &trans       &trans
                                  &trans    &trans    &trans      &trans     &trans       &trans
                        >;
                };

                mouse_layer {
                        bindings = <
   &trans &trans &trans &trans &trans &trans            &trans &mkp LCLK &msc SCRL_DOWN &msc SCRL_UP &trans &to GALLIUM
   &trans &trans &mkp RCLK &mkp LCLK &trans &trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &kp RCTRL &to MAC
   &trans &trans &trans &trans &trans &trans            &trans  &mkp MCLK &msc SCRL_LEFT &msc SCRL_RIGHT &trans &to BASE
                         &trans &kp LSHIFT &trans           &trans &mkp MB4 &mkp MB5
                        >;
                };

                numpad_layer {
                        bindings = <
   &trans &trans &trans &trans &trans &trans      &trans &kp N7 &kp N8 &kp N9 &kp ASTERISK &trans
   &trans &trans &trans &trans &kp LALT &trans      &kp EQUAL &kp N1 &kp N2 &kp N3 &kp PLUS &trans
   &trans &trans &trans &trans &trans &trans      &kp FSLH &kp N4 &kp N5 &kp N6 &kp MINUS &trans
                         &kp LGUI &kp BSPC &kp SPACE     &kp RET &kp N0 &kp RCTRL
                        >;
                };
        };

};

&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <2>;
};

&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <2>;
};




